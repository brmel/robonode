<!-- Real UR10e (MuJoCo Menagerie: meshes, inertias, tuned servos) on a 7th-axis
     rail. The UR bodies/offsets/joint-axes are the menagerie model verbatim —
     so FK/IK here is a faithful UR10e. Local renames only: joints → j1..j6,
     actuators → j*_servo, flange site → tcp, so the cell descriptor and
     kinematics (which speak j1..j6 + "tcp") are unchanged.

     The home keyframe sets BOTH qpos and ctrl to the UR "ready" pose, so the
     servos hold a natural folded posture at rest instead of snapping to a
     vertical mast — the fix that also lets moves start from a real pose (#65).
     qpos/ctrl order: rail, j1..j6, belt_x — the belt joint is part of the state,
     so the keyframe must name it or the workpiece wakes up at a joint stop. -->
<mujoco model="rail_ur10e">
  <compiler angle="radian" meshdir="assets" autolimits="true"/>
  <option integrator="implicitfast" timestep="0.002"/>

  <default>
    <default class="ur10e">
      <material specular="0.5" shininess="0.25"/>
      <joint axis="0 1 0" range="-6.28319 6.28319" armature="0.1"/>
      <general biastype="affine" ctrlrange="-6.2831 6.2831" gainprm="5000" biasprm="0 -5000 -500"/>
      <default class="size4">
        <joint damping="10"/>
        <general forcerange="-330 330"/>
      </default>
      <default class="size3">
        <joint damping="5"/>
        <general forcerange="-150 150"/>
        <default class="size3_limited">
          <joint range="-3.1415 3.1415"/>
          <general ctrlrange="-3.1415 3.1415"/>
        </default>
      </default>
      <default class="size2">
        <joint damping="2"/>
        <general forcerange="-56 56"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <!-- Contact groups, by what a thing IS:
             1  robot links     — stopped by structure (2) and by parts (4)
             2  structure       — floor, fixtures: everything hits it
             4  parts           — hit by the arm, ride the belt, stack on each other
             8  work surface    — the belt: carries parts, ignores the arm
            16  the tool tip    — reaches into a part to hold it; hits structure
           The robot accepts nothing from its own group, so self-collision never
           quietly holds a joint off target. -->
      <default class="collision">
        <geom type="capsule" group="3" contype="1" conaffinity="6"/>
        <!-- The tool tip is a suction cup: it must reach INTO the part it is
             about to hold, so parts take no contact from it — a cup that shoved
             its target away could never pick anything up. Every other link of
             the arm still collides with parts and structure. -->
        <default class="eef_collision">
          <geom type="cylinder" contype="16" conaffinity="2"/>
        </default>
      </default>
      <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/>
    </default>
  </default>

  <asset>
    <material class="ur10e" name="black" rgba="0.033 0.033 0.033 1"/>
    <material class="ur10e" name="jointgray" rgba="0.278 0.278 0.278 1"/>
    <material class="ur10e" name="linkgray" rgba="0.82 0.82 0.82 1"/>
    <material class="ur10e" name="urblue" rgba="0.49 0.678 0.8 1"/>
    <!-- Cell furniture, named so a viewer can theme it like any other material. -->
    <material name="carriage" rgba="0.81 0.54 0.23 1"/>
    <material name="rail" rgba="0.165 0.2 0.251 1"/>
    <material name="belt" rgba="0.22 0.24 0.28 1"/>
    <material name="part" rgba="0.886 0.231 0.231 1"/>
    <mesh file="base_0.obj"/><mesh file="base_1.obj"/>
    <mesh file="shoulder_0.obj"/><mesh file="shoulder_1.obj"/><mesh file="shoulder_2.obj"/>
    <mesh file="upperarm_0.obj"/><mesh file="upperarm_1.obj"/><mesh file="upperarm_2.obj"/><mesh file="upperarm_3.obj"/>
    <mesh file="forearm_0.obj"/><mesh file="forearm_1.obj"/><mesh file="forearm_2.obj"/><mesh file="forearm_3.obj"/>
    <mesh file="wrist1_0.obj"/><mesh file="wrist1_1.obj"/><mesh file="wrist1_2.obj"/>
    <mesh file="wrist2_0.obj"/><mesh file="wrist2_1.obj"/><mesh file="wrist2_2.obj"/>
    <mesh file="wrist3.obj"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="4 4 0.1" rgba="0.3 0.3 0.35 1"
          contype="2" conaffinity="7"/>
    <!-- The linear-axis beam. Visual only (contype/conaffinity 0): it carries no
         contacts, but it belongs to the model so every viewer draws the same
         cell instead of inventing its own furniture. -->
    <geom name="rail_beam" type="box" size="0.825 0.13 0.025" pos="0.5 0 0.03"
          contype="0" conaffinity="0" material="rail"/>

    <!-- 7th axis: linear carriage 0..1.45 m along X. -->
    <body name="carriage" pos="0 0 0.1">
      <joint name="rail" type="slide" axis="1 0 0" range="0 1.45" damping="30"/>
      <geom type="box" size="0.11 0.11 0.06" mass="12" material="carriage"/>

      <!-- Real UR10e base on the carriage (menagerie geometry verbatim). -->
      <body name="base" pos="0 0 0.06" quat="0 0 0 -1" childclass="ur10e">
        <inertial mass="4.0" pos="0 0 0" diaginertia="0.0061063308908 0.0061063308908 0.01125"/>
        <geom mesh="base_0" material="black" class="visual"/>
        <geom mesh="base_1" material="jointgray" class="visual"/>
        <body name="shoulder_link" pos="0 0 0.181">
          <inertial pos="0 0 0" mass="7.778" diaginertia="0.0314743 0.0314743 0.0218756"/>
          <joint name="j1" class="size4" axis="0 0 1"/>
          <geom mesh="shoulder_0" material="urblue" class="visual"/>
          <geom mesh="shoulder_1" material="black" class="visual"/>
          <geom mesh="shoulder_2" material="jointgray" class="visual"/>
          <geom class="collision" size="0.078 0.08" pos="0 0 -0.05"/>
          <body name="upper_arm_link" pos="0 0.176 0" quat="1 0 1 0">
            <inertial pos="0 0 0.3065" mass="12.93" diaginertia="0.423074 0.423074 0.0363656"/>
            <joint name="j2" class="size4"/>
            <geom mesh="upperarm_0" material="black" class="visual"/>
            <geom mesh="upperarm_1" material="jointgray" class="visual"/>
            <geom mesh="upperarm_2" material="urblue" class="visual"/>
            <geom mesh="upperarm_3" material="linkgray" class="visual"/>
            <geom class="collision" pos="0 -0.05 0" quat="1 1 0 0" size="0.078 0.08"/>
            <geom class="collision" size="0.06 0.3" pos="0 0 0.3"/>
            <body name="forearm_link" pos="0 -0.137 0.613">
              <inertial pos="0 0 0.2855" mass="3.87" diaginertia="0.11059 0.11059 0.0108844"/>
              <joint name="j3" class="size3_limited"/>
              <geom mesh="forearm_0" material="urblue" class="visual"/>
              <geom mesh="forearm_1" material="black" class="visual"/>
              <geom mesh="forearm_2" material="jointgray" class="visual"/>
              <geom mesh="forearm_3" material="linkgray" class="visual"/>
              <geom class="collision" pos="0 0.08 0" quat="1 1 0 0" size="0.058 0.065"/>
              <geom class="collision" size="0.043 0.28" pos="0 0 0.29"/>
              <body name="wrist_1_link" pos="0 0 0.571" quat="1 0 1 0">
                <inertial pos="0 0.135 0" quat="0.5 0.5 -0.5 0.5" mass="1.96"
                  diaginertia="0.0055125 0.00510825 0.00510825"/>
                <joint name="j4" class="size2"/>
                <geom mesh="wrist1_0" material="black" class="visual"/>
                <geom mesh="wrist1_1" material="urblue" class="visual"/>
                <geom mesh="wrist1_2" material="jointgray" class="visual"/>
                <geom class="collision" pos="0 0.06 0" quat="1 1 0 0" size="0.05 0.07"/>
                <body name="wrist_2_link" pos="0 0.135 0">
                  <inertial pos="0 0 0.12" quat="0.5 0.5 -0.5 0.5" mass="1.96"
                    diaginertia="0.0055125 0.00510825 0.00510825"/>
                  <joint name="j5" axis="0 0 1" class="size2"/>
                  <geom mesh="wrist2_0" material="black" class="visual"/>
                  <geom mesh="wrist2_1" material="urblue" class="visual"/>
                  <geom mesh="wrist2_2" material="jointgray" class="visual"/>
                  <geom class="collision" size="0.046 0.065" pos="0 0 0.05"/>
                  <geom class="collision" pos="0 0.028 0.12" quat="1 1 0 0" size="0.046 0.043"/>
                  <body name="wrist_3_link" pos="0 0 0.12">
                    <inertial pos="0 0.092 0" quat="0 1 -1 0" mass="0.202"
                      diaginertia="0.000204525 0.000144346 0.000144346"/>
                    <joint name="j6" class="size2"/>
                    <geom material="linkgray" mesh="wrist3" class="visual"/>
                    <geom class="eef_collision" pos="0 0.097 0" quat="1 1 0 0" size="0.046 0.02"/>
                    <!-- The tool. A bare flange cannot pick anything: the wrist
                         itself reaches the part before the tool point does and
                         knocks it away. This is a 10 cm suction cup, and the TCP
                         is its tip — so the arm stands off the work like a real
                         cell does. -->
                    <geom name="cup" class="eef_collision" type="cylinder" size="0.018 0.05"
                          pos="0 0.15 0" quat="1 1 0 0" material="jointgray" mass="0.3"/>
                    <site name="tcp" pos="0 0.2 0" quat="-1 1 0 0"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Conveyor: a belt surface that really moves. It slides along its axis
         and carries the workpiece by FRICTION — nothing teleports the part, so
         a picking algorithm intercepts a body the physics is transporting.
         The belt is cell furniture (group 2): parts rest on it and the arm is
         stopped by it instead of reaching through. -->
    <body name="conveyor" pos="0.9 0.25 0.33">
      <joint name="belt_x" type="slide" axis="-1 0 0" range="-0.6 0.6" damping="8"/>
      <!-- The belt carries PARTS (group 4). It takes no contact from the arm:
           a 6-DoF wrist working a 3 cm part sitting 3 cm above a conveyor
           grazes the belt constantly, and "the tool touched the table" is not
           the failure this cell exists to teach. Obstacles that should stop the
           arm are placed in a scene, where working around them is the point. -->
      <geom name="belt" type="box" size="0.55 0.09 0.015" contype="8" conaffinity="4"
            material="belt" friction="1.4 0.02 0.001"/>
    </body>

    <!-- The pick zone, as static frames: where the line delivers from and to.
         They mark the cell, so they must not travel with the belt. -->
    <site name="belt_start" pos="1.25 0.25 0.35" size="0.004"/>
    <site name="belt_end" pos="0.4 0.25 0.35" size="0.004"/>

    <!-- Clutter: the same colour as the workpiece and larger, sitting beside the
         line. "Find the biggest red blob" picks this every time; the part's
         known size is what tells them apart. It is something to SEE, not
         something to hit — obstacles are placed in a scene (cluttered-line),
         where working around them is the point. -->
    <body name="decoy" pos="0.62 0.25 0.37">
      <geom type="box" size="0.05 0.05 0.02" material="part" contype="0" conaffinity="0"/>
      <site name="decoy" pos="0 0 0" size="0.006"/>
    </body>

    <!-- The pallet: where placed parts end up. Structure, so the arm is stopped
         by it and a released part lands on it instead of on the floor. -->
    <body name="pallet" pos="0.55 -0.55 0.15">
      <geom type="box" size="0.26 0.2 0.15" material="carriage" contype="2" conaffinity="7"/>
      <site name="pallet_origin" pos="0 0 0.15" size="0.004"/>
    </body>

    <!-- The workpiece: a free rigid body. It rides the belt because friction
         carries it, it can be picked up because a gripper can weld to it, and
         it falls when released — there is no pose the platform writes by hand. -->
    <body name="part" pos="1.05 0.25 0.376">
      <freejoint name="part_free"/>
      <geom type="box" size="0.03 0.03 0.03" material="part" contype="4" conaffinity="15"
            mass="0.4" friction="1.2 0.02 0.001"/>
      <site name="part" pos="0 0 0" size="0.006"/>
    </body>
  </worldbody>

  <!-- A grasp is a constraint, not a fiction: closing the tool welds the part
       to the wrist where it actually caught it, and releasing lets go. -->
  <equality>
    <weld name="grip" body1="wrist_3_link" body2="part" active="false" solref="0.004 1"/>
  </equality>

  <actuator>
    <position name="rail_servo" joint="rail" kp="8000" kv="400" ctrlrange="0 1.45"/>
    <general class="size4" name="j1_servo" joint="j1"/>
    <general class="size4" name="j2_servo" joint="j2"/>
    <general class="size3_limited" name="j3_servo" joint="j3"/>
    <general class="size2" name="j4_servo" joint="j4"/>
    <general class="size2" name="j5_servo" joint="j5"/>
    <general class="size2" name="j6_servo" joint="j6"/>
    <!-- LAST on purpose: ctrl is positional, and the home keyframe addresses
         actuators by index. The belt runs at a commanded speed (m/s) and the
         workpiece rides it — the part arrives and leaves like a real line. -->
    <velocity name="belt_drive" joint="belt_x" kv="400" ctrlrange="-1 1"/>
  </actuator>

  <keyframe>
    <!-- qpos: rail, j1..j6, belt_x, then the part's free joint (xyz + quat).
         ctrl: the seven servos, then the belt speed. -->
    <key name="home"
         qpos="0.6 -1.5708 -1.5708 1.5708 -1.5708 -1.5708 0 -0.45 1.05 0.25 0.376 1 0 0 0"
         ctrl="0.6 -1.5708 -1.5708 1.5708 -1.5708 -1.5708 0 0"/>
  </keyframe>
</mujoco>
